# Copy to .env. Never commit .env.

# OpenRouter, used to read the thesis and write the spec.
OPENROUTER_API_KEY=

# Any OpenRouter model id. Falls back to qwen/qwen3.8-27b:free if this one is down.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Exa, the main search adapter (step 2).
EXA_API_KEY=
